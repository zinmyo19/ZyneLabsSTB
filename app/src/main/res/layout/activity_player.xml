<?xml version="1.0" encoding="utf-8"?>
<!-- v5.1: FlowPlay-style player — custom controller (PlayerView controller OFF):
     transparent floating top bar, info box, bottom transport with seek bar,
     inline settings strip. Fully D-pad navigable, auto-hides. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- ===== Top bar (transparent, floating) ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/nav_item_selector"
            android:focusable="true"
            android:text="‹"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_live"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="● LIVE"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- v6.3.2: top bar decluttered — tracks/info/pip/record/settings/
             channels/lock moved into the gear menu. -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nav_item_selector"
            android:contentDescription="Player options"
            android:focusable="true"
            android:src="@drawable/ic_nav_settings" />
    </LinearLayout>

    <!-- ===== Info box (with controls) ===== -->
    <LinearLayout
        android:id="@+id/infoBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="88dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/info_box_background"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvInfoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInfoMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/gold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== Bottom: settings strip + transport (v6.3.2: centered
         floating pill, FlowPlay style) ===== -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Inline settings strip -->
        <LinearLayout
            android:id="@+id/settingsStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSpeed"
                style="@style/PlayerChipButton"
                android:text="1x" />

            <Button
                android:id="@+id/btnAudio"
                style="@style/PlayerChipButton"
                android:text="Audio" />

            <Button
                android:id="@+id/btnSubtitles"
                style="@style/PlayerChipButton"
                android:text="Subs" />

            <Button
                android:id="@+id/btnAspect"
                style="@style/PlayerChipButton"
                android:text="16:9" />
        </LinearLayout>

        <!-- Transport (v6.3.2: centered row inside the floating pill) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- v5.5: full FlowPlay transport — rewind, prev, play/pause,
                 next, forward, aspect, volume (gold vectors, D-pad focusable).
                 Rewind/forward show for VOD only. -->
            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/rewind_10s"
                android:focusable="true"
                android:src="@drawable/ic_rewind"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/prev_channel"
                android:focusable="true"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/play_pause"
                android:focusable="true"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/next_channel"
                android:focusable="true"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/forward_10s"
                android:focusable="true"
                android:src="@drawable/ic_forward"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnAspectTransport"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/aspect_button"
                android:focusable="true"
                android:src="@drawable/ic_aspect" />

            <ImageButton
                android:id="@+id/btnVolume"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/nav_item_selector"
                android:contentDescription="@string/volume_button"
                android:focusable="true"
                android:src="@drawable/ic_volume" />

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- v6.3.2: fixed 220dp (wrap_content parent) instead of weight. -->
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:max="1000"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/gold" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- ===== v5.4: swipe-gesture bars (volume LEFT, brightness RIGHT — swapped per his spec) ===== -->
    <LinearLayout
        android:id="@+id/volumeBar"
        android:layout_width="56dp"
        android:layout_height="220dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/gesture_bar_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_volume" />

        <ProgressBar
            android:id="@+id/volumeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/gold"
            android:rotation="270" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/brightnessBar"
        android:layout_width="56dp"
        android:layout_height="220dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:background="@drawable/gesture_bar_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_brightness" />

        <ProgressBar
            android:id="@+id/brightnessProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/gold"
            android:rotation="270" />

    </LinearLayout>

    <!-- ===== Drawer scrim ===== -->
    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- ===== Channels drawer (right slide-in, v5.3) ===== -->
    <LinearLayout
        android:id="@+id/drawerChannels"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F20A0F14"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_channels_title"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerGenreList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/drawerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/gold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===== Settings drawer (right slide-in, v5.3) ===== -->
    <LinearLayout
        android:id="@+id/drawerSettings"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F20A0F14"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drawer_settings_title"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawerSettingsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- ===== v5.5: screen-lock overlay (FlowPlay) — tap to unlock ===== -->
    <LinearLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/unlock_hint"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
