<?xml version="1.0" encoding="utf-8"?>
<!-- v6.3.17: active nav row — gold pill, plus teal stroke ring when D-pad
     focused (was a plain shape with no focused state, so the active row
     could never show focus). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold" />
            <stroke android:width="3dp" android:color="@color/teal" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold" />
            <stroke android:width="3dp" android:color="@color/teal" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
