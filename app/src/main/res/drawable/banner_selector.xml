<?xml version="1.0" encoding="utf-8"?>
<!-- v5.2: featured banner — gold gradient normally, teal ring when focused (D-pad). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#16303A" />
            <stroke android:width="3dp" android:color="@color/teal" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#16303A" />
            <stroke android:width="3dp" android:color="@color/teal" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#4A3A10"
                android:centerColor="#241B08"
                android:endColor="#0A0F14" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
